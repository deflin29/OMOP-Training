library(omock)
library(DBI)
# 2. Create the CDM object (first run downloads synpuf-1k)
cdm <- omock::mockCdmFromDataset(source = "duckdb", datasetName = "synpuf-1k")
# 2. Create the CDM object - only once per R session
if (!exists("cdm")) {
cdm <- omock::mockCdmFromDataset(source = "duckdb", datasetName = "synpuf-1k")
}
