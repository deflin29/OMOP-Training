# STEP 1: INSTALL AND LOAD REQUIRED PACKAGES
# ============================================================
required_packages <- c(
"omock",
"CDMConnector",
"CodelistGenerator",
"CohortConstructor",
"CohortCharacteristics",
"duckdb",
"DBI",
"dplyr",
"gt",
"here",
"omopgenerics"
)
missing_packages <- required_packages[
!vapply(
required_packages,
requireNamespace,
quietly = TRUE,
FUN.VALUE = logical(1)
)
]
if (length(missing_packages) > 0) {
install.packages(missing_packages)
}
