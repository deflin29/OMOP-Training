# ============================================================
# HDS OMOP TRAINING
# Exercise 2: Requirement and Filtering
# Exercise 3: Update Cohort Entry and Exit
# Dataset: Delphi 100K
# ============================================================
# ============================================================
# STEP 1: INSTALL AND LOAD REQUIRED PACKAGES
# ============================================================
required_packages <- c(
"omock",
"CDMConnector",
"CodelistGenerator",
"CohortConstructor",
"CohortCharacteristics",
"duckdb",
"DBI",
"dplyr",
"gt",
"here",
"omopgenerics"
)
missing_packages <- required_packages[
!vapply(
required_packages,
requireNamespace,
quietly = TRUE,
FUN.VALUE = logical(1)
)
]
if (length(missing_packages) > 0) {
install.packages(missing_packages)
}
# Load packages
library(omock)
library(CDMConnector)
library(CodelistGenerator)
library(CohortConstructor)
library(CohortCharacteristics)
library(duckdb)
library(DBI)
library(dplyr)
library(gt)
library(here)
library(omopgenerics)
# ============================================================
# STEP 2: DOWNLOAD AND PREPARE DELPHI 100K DATASET
# ============================================================
# If you previously encountered a corrupted Parquet download,
# run this once to replace the existing dataset.
downloadMockDataset(
datasetName = "delphi-100k_5.4",
overwrite = TRUE
)
