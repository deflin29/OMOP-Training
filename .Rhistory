# 1. Load packages
library(PatientProfiles)
library(CDMConnector)
library(CohortConstructor)
library(duckdb)
library(dplyr)
library(here)
library(omock)
library(DBI)
here()
if (!exists("cdm")) {
cdm <- omock::mockCdmFromDataset(source = "duckdb", datasetName = "synpuf-1k")
}
# 3. Create the cohorts from the slides
cdm$my_cohort <- conceptCohort(
cdm = cdm,
conceptSet = list(arthritis = c(80180, 80809)),
name = "my_cohort"
)
cdm$medications <- conceptCohort(        # needed for the next Your Turn
cdm = cdm,
conceptSet = list(heparin = 1367571),
name = "medications"
)
cdm$my_cohort
my_cohort_demographics <- cdm$my_cohort |>
addDemographics(
age = FALSE,                    # don't keep numeric age
ageGroup = list(                # -> "age_group" column
"<18"   = c(0, 17),
"18-64" = c(18, 64),
"65+"   = c(65, Inf)
),
sex = TRUE,                     # -> "sex" column
priorObservation = TRUE,        # -> "prior_observation"
priorObservationType = "days",
futureObservation = TRUE,       # -> "future_observation"
futureObservationType = "days"
)
my_cohort_demographics |> glimpse()
my_cohort_demographics |>
count(sex, age_group) |>
collect()
# 1. Load packages
library(PatientProfiles)
library(CDMConnector)
library(CohortConstructor)
library(duckdb)
library(dplyr)
library(here)
library(omock)
library(DBI)
# 2. Create the CDM object - reload if missing OR its connection is dead
if (!exists("cdm") || !DBI::dbIsValid(CDMConnector::cdmCon(cdm))) {
cdm <- omock::mockCdmFromDataset(source = "duckdb", datasetName = "synpuf-1k")
}
# 3. Create the cohorts from the slides
cdm$my_cohort <- conceptCohort(
cdm = cdm,
conceptSet = list(arthritis = c(80180, 80809)),
name = "my_cohort"
)
cdm$medications <- conceptCohort(        # needed for the next Your Turn
cdm = cdm,
conceptSet = list(heparin = 1367571),
name = "medications"
)
cdm$my_cohort
# 4. Your Turn 1: add demographics (index date = cohort_start_date)
my_cohort_demographics <- cdm$my_cohort |>
addDemographics(
age = FALSE,                    # don't keep numeric age
ageGroup = list(                # -> "age_group" column
"<18"   = c(0, 17),
"18-64" = c(18, 64),
"65+"   = c(65, Inf)
),
sex = TRUE,                     # -> "sex" column
priorObservation = TRUE,        # -> "prior_observation"
priorObservationType = "days",
futureObservation = TRUE,       # -> "future_observation"
futureObservationType = "days"
)
my_cohort_demographics |> glimpse()
my_cohort_demographics |>
count(sex, age_group) |>
collect()
# 5. Your Turn 2: year before index = window c(-365, -1) days
my_cohort_prior <- cdm$my_cohort |>
addCohortIntersectFlag(
targetCohortTable = "medications",
targetCohortId = "heparin",
window = c(-365, -1),
nameStyle = "prior_{cohort_name}"   # -> "prior_heparin" (1 = yes, 0 = no)
) |>
addTableIntersectCount(
tableName = "condition_occurrence",
window = c(-365, -1),
nameStyle = "prior_conditions"      # -> number of condition records
)
my_cohort_prior |> glimpse()
my_cohort_prior |>
count(prior_heparin) |>
collect()
my_cohort_demographics |> collect() |> View()
my_cohort_prior |> collect() |> View()
library(ggplot2)
my_cohort_demographics |>
collect() |>
ggplot(aes(x = age_group, fill = sex)) +
geom_bar(position = "dodge") +
labs(x = "Age group", y = "Number of records",
title = "Arthritis cohort by age group and sex")
install.packages(c("visOmopResults", "DiagrammeR"))
library(CohortCharacteristics)
# Flowchart: how many people/records at each cohort-building step
cdm$my_cohort |>
summariseCohortAttrition() |>
plotCohortAttrition()
# Formatted summary table (sex, age groups, observation time...)
cdm$my_cohort |>
summariseCharacteristics(ageGroup = list(c(0, 17), c(18, 64), c(65, Inf))) |>
tableCharacteristics()
cdm$my_cohort |>
summariseCohortAttrition() |>
plotCohortAttrition()
cdm$condition_occurrence |> count(condition_concept_id, sort = TRUE) |> left_join(cdm$concept |> select(concept_id, concept_name), by = c("condition_concept_id" = "concept_id")) |> collect() |> View()
install.packages("CohortCharacteristics")
library(DiagrammeR)
library(DiagrammeRsvg)
install.packages("DiagrammeR")
here()
# 1. Load packages
library(duckdb)
library(CDMConnector)
library(CohortConstructor)
library(PatientProfiles)
library(CohortCharacteristics)
library(CodelistGenerator)
library(dplyr)
library(here)
library(omock)
library(DiagrammeR)
library(DiagrammeRsvg)
library(rsvg)
library(grid)
library(png)
# 2. Create the CDM object - reload only if missing OR its connection is dead
if (!exists("cdm") || !DBI::dbIsValid(CDMConnector::cdmCon(cdm))) {
cdm <- omock::mockCdmFromDataset(source = "duckdb", datasetName = "synpuf-1k")
}
# 3. Create the cohorts from the slides (one cohort per codelist)
x <- c(list(anemia = 439777,
rheumatoid_arthritis = 80809,
osteoarthritis = 80180,
pneumonia = 255848),
getDrugIngredientCodes(cdm, c("heparin", "clopidogrel"),
nameStyle = "{concept_name}")) |>
newCodelist()
cdm[["my_cohort"]] <- conceptCohort(cdm = cdm,
conceptSet = x,
name = "my_cohort")
settings(cdm$my_cohort)   # cohort names: osteoarthritis, heparin, pneumonia, ...
# 4. Your Turn ---------------------------------------------------
# 4a. Only demographics (the default of summariseCharacteristics)
result_demo <- summariseCharacteristics(
cohort = cdm$my_cohort,
cohortId = "osteoarthritis"
)
tableCharacteristics(result = result_demo, header = "cohort_name")
# 4b. Demographics + heparin (prior 180 days) + pneumonia (prior 2 years)
#     window c(-180, 0)  = 180 days before up to and INCLUDING the index date
#     window c(-730, -1) = 2 years before up to the day BEFORE the index date
result <- summariseCharacteristics(
cohort = cdm$my_cohort,
cohortId = "osteoarthritis",
cohortIntersectFlag = list(
"Heparin prescriptions during the prior 180 days" = list(
targetCohortTable = "my_cohort",
targetCohortId = "heparin",
window = c(-180, 0)
),
"Pneumonia diagnosis during the prior 2 years" = list(
targetCohortTable = "my_cohort",
targetCohortId = "pneumonia",
window = c(-730, -1)
)
)
)
tableCharacteristics(result = result, header = "cohort_name")
source("D:/PHI-LAB/OMPO-Training/OMOP-Training-Prj/day-3-cohortCharacterization-Slides.R")
result <- cdm$my_cohort |>
summariseCharacteristics() |>
filter(variable_name == "Age")
result <- cdm$my_cohort |>
summariseCharacteristics() |>
filter(variable_name == "Age")
plotCharacteristics(result = result, plotStyle = "boxplot", colour = "cohort_name")
tableCharacteristics(result = result, header = "cohort_name")
result <- cdm$my_cohort |>
summariseCharacteristics(cohortId = "osteoarthritis") |>
filter(variable_name == "Sex" & estimate_name == "percentage")
plotCharacteristics(result = result,
plotStyle = "barplot",
facet = "cohort_name",
colour = "variable_level")
result <- cdm$my_cohort |>
summariseLargeScaleCharacteristics(
window = list(c(-Inf, -1), c(1, Inf)),
eventInWindow = "condition_occurrence",
minimumFrequency = 0.05
)
glimpse(result)
glimpse(result)
plotCohortOverlap(result = result, uniqueCombinations = TRUE)
result <- cdm$my_cohort |>
summariseCohortOverlap()
glimpse(result)
plotCohortOverlap(result = result, uniqueCombinations = TRUE)
plotCohortTiming(
result = result,
plotType = "densityplot",
timeScale = "years",
uniqueCombinations = FALSE
)
tableCohortTiming(result = result,
timeScale = "years",
uniqueCombinations = FALSE)
plotCohortTiming(
result = result,
plotType = "densityplot",
timeScale = "years",
uniqueCombinations = FALSE
)
result <- cdm$my_cohort |>
summariseCohortTiming(restrictToFirstEntry = TRUE)
glimpse(result)
glimpse(result)
plotCohortOverlap(result = result, uniqueCombinations = TRUE)
tableCohortTiming(result = result,
timeScale = "years",
uniqueCombinations = FALSE)
plotCohortTiming(
result = result,
plotType = "densityplot",
timeScale = "years",
uniqueCombinations = FALSE
)
result <- cdm$my_cohort |>
summariseLargeScaleCharacteristics(
cohortId = "clopidogrel",
window = list(c(-Inf, -1)),
episodeInWindow = "drug_exposure",
minimumFrequency = 0.05
)
tableTopLargeScaleCharacteristics(result = result, topConcepts = 5)
result <- cdm$my_cohort |>
summariseLargeScaleCharacteristics(
cohortId = "osteoarthritis",
window = list(c(-Inf, -1)),
episodeInWindow = "drug_exposure",
minimumFrequency = 0.05
)
tableTopLargeScaleCharacteristics(result = result, topConcepts = 5)
