
# ============================================
# ANNUAL ASTHMA CASES - OMOP CDM
# Dataset: GiBleed
# ============================================

library(dplyr)
library(ggplot2)
library(lubridate)

# STEP 1: Find valid standard asthma concepts
asthma_codes <- cdm$concept |>
  filter(
    domain_id == "Condition",
    standard_concept == "S",
    is.na(invalid_reason),
    grepl("asthma", concept_name, ignore.case = TRUE)
  ) |>
  select(
    concept_id,
    concept_name,
    vocabulary_id
  ) |>
  collect()

# Check available concepts
cat("\nSTEP 1: Asthma concepts found:\n")
print(asthma_codes)

cat("\nTotal asthma concepts:", nrow(asthma_codes), "\n")


# STEP 2: Extract concept IDs
asthma_concept_ids <- asthma_codes$concept_id

# Stop if no concepts were found
if (length(asthma_concept_ids) == 0) {
  stop("No valid standard asthma concepts found. Check the concept table.")
}


# STEP 3: Retrieve asthma diagnosis records
asthma_records <- cdm$condition_occurrence |>
  filter(condition_concept_id %in% asthma_concept_ids) |>
  collect()

cat("\nSTEP 2: Asthma diagnosis records found:\n")
cat("Total records:", nrow(asthma_records), "\n")


# STEP 4: Check whether records exist
if (nrow(asthma_records) == 0) {
  stop("Asthma concepts were found, but no matching diagnosis records exist.")
}


# STEP 5: Extract diagnosis year
asthma_records <- asthma_records |>
  mutate(
    year = year(as.Date(condition_start_date))
  ) |>
  filter(!is.na(year))


# STEP 6: Calculate annual unique patients
annual_asthma <- asthma_records |>
  group_by(year) |>
  summarise(
    asthma_cases = n_distinct(person_id),
    .groups = "drop"
  ) |>
  arrange(year)

cat("\nSTEP 3: Annual asthma cases:\n")
print(annual_asthma)


# STEP 7: Plot annual asthma cases
if (nrow(annual_asthma) > 0) {
  
  p <- ggplot(
    annual_asthma,
    aes(x = year, y = asthma_cases)
  ) +
    
    geom_col(
      fill = "#3569A8",
      width = 0.7
    ) +
    
    geom_text(
      aes(label = asthma_cases),
      vjust = -0.4,
      size = 4
    ) +
    
    scale_x_continuous(
      breaks = annual_asthma$year
    ) +
    
    expand_limits(
      y = max(annual_asthma$asthma_cases) * 1.15
    ) +
    
    labs(
      title = "Annual Asthma Cases",
      subtitle = "GiBleed OMOP CDM Dataset",
      x = "Year",
      y = "Number of Unique Patients"
    ) +
    
    theme_minimal(base_size = 13) +
    
    theme(
      plot.title = element_text(
        face = "bold",
        size = 16
      ),
      plot.subtitle = element_text(
        color = "grey40"
      ),
      axis.text.x = element_text(
        angle = 45,
        hjust = 1
      ),
      panel.grid.minor = element_blank()
    )
  
  print(p)
  
} else {
  message("No annual data available to plot.")
}
